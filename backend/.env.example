# Copy to backend/.env. Use your own PostgreSQL URL; never commit credentials.
DATABASE_URL=postgresql+psycopg://paris:local-development-only@127.0.0.1:55432/paris_fc
CORS_ORIGINS=["http://localhost:4173"]
CONTACT_ENABLED=false

# Generate a random secret of at least 32 characters. Never reuse development secrets.
JWT_SECRET=
# False for localhost HTTP only; keep true for HTTPS deployments.
AUTH_COOKIE_SECURE=false
AUTH_TTL_SECONDS=28800

# Hosting: APP_ENV=production, AUTH_COOKIE_SECURE=true, exact HTTPS CORS origins.
APP_ENV=development
# Optional direct Neon URL for Alembic; DATABASE_URL can use the pooled endpoint.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
